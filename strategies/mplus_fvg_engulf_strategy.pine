//@version=6
// =============================================================================
//  M+ FVG Engulf  —  Strategy
// -----------------------------------------------------------------------------
//  Backtestable version of indicators/mplus_fvg_engulf.pine. The setup engine,
//  trade tracker and dashboard below are the same as the indicator's, so the
//  two always agree — keep them in sync when editing.
//
//  Rules and their source quotes: docs/SPEC.md
//  Chart must be on the ENTRY timeframe (1m); the gap timeframe is an input.
//
//  Signals fire on confirmed bars and fill at the next bar's open, so the
//  backtest does not read the future.
// =============================================================================

strategy("M+ FVG Engulf Strategy", shorttitle = "M+ FVG ST", overlay = true,
     initial_capital     = 10000,
     default_qty_type    = strategy.percent_of_equity,
     default_qty_value   = 10,
     pyramiding          = 0,
     calc_on_every_tick  = false,
     commission_type     = strategy.commission.percent,
     commission_value    = 0.0,
     slippage            = 0,
     max_boxes_count     = 500,
     max_labels_count    = 500,
     max_lines_count     = 500)

// ----------------------------------------------------------------- inputs ---
G_TF   = "1 · Timeframes"
G_RULE = "2 · Setup rules"
G_RISK = "3 · Risk & targets"
G_FILT = "4 · Filters"
G_VIS  = "5 · Visuals"
G_DASH = "6 · Dashboard"

htfTf = input.timeframe("15", "FVG timeframe", group = G_TF,
     tooltip = "تایم‌فریمی که FVG روی آن تشکیل می‌شود (طبق فایل صوتی: ۱۵ دقیقه). چارت را روی تایم ورود (۱ دقیقه) بگذارید.")

maxClosesInside = input.int(2, "Max closes inside the gap", minval = 1, maxval = 5, group = G_RULE,
     tooltip = "حداکثر تعداد کندلی که مجاز است داخل FVG کلوز کند. سه کلوز = ستاپ باطل.")
maxBarsToEngulf = input.int(4, "Max bars to engulf", minval = 1, maxval = 30, group = G_RULE,
     tooltip = "اگر تا این تعداد کندل بعد از ورود قیمت به FVG اینگالف رخ ندهد، ستاپ باطل می‌شود («سه چهار تا کندل شد دیگه کنسل»).")
maxUpdates = input.int(1, "Max reference-candle updates", minval = 0, maxval = 3, group = G_RULE,
     tooltip = "کندل مرجع حداکثر چند بار می‌تواند آپدیت شود. طبق فایل صوتی فقط یک بار.")
killOnBreak = input.bool(true, "Cancel when a close passes through the gap", group = G_RULE)
allowLong  = input.bool(true, "Longs",  group = G_RULE, inline = "dir")
allowShort = input.bool(true, "Shorts", group = G_RULE, inline = "dir")
maxZones   = input.int(40, "Max tracked gaps", minval = 5, maxval = 200, group = G_RULE)
oneAtATime = input.bool(true, "Skip signals while a trade is open", group = G_RULE,
     tooltip = "در فایل صوتی پرسیده شد ولی جواب داده نشد («همزمان به دوتاش بخوره»). پیش‌فرض: فقط یک پوزیشن.")

rr       = input.float(3.0, "Reward : Risk", minval = 0.5, step = 0.5, group = G_RISK)
stopMode = input.string("Swing since gap entry", "Stop loss placement",
     options = ["Swing since gap entry", "Reference candle", "Far edge of gap"], group = G_RISK,
     tooltip = "پیش‌فرض با نمونه‌ی بک‌تست XAUUSD خوانده شد: ورود ۴۳۱۹٫۹۳ / استاپ ۴۳۲۲٫۸۸ / تارگت ۴۳۱۰٫۹۴ ≈ ۱:۳")
stopBufTicks = input.int(0, "Stop buffer (ticks)", minval = 0, group = G_RISK)
useRiskSize  = input.bool(true, "Size position by risk %", group = G_RISK)
riskPct      = input.float(1.0, "Risk per trade %", minval = 0.01, step = 0.1, group = G_RISK)
usePartial   = input.bool(false, "Partial exit + move to break-even", group = G_RISK,
     tooltip = "در فایل صوتی مطرح شد ولی تصمیم قطعی گرفته نشد: «نمیدونم ریسک فری کنیم یا 50 درصد خروج کنیم». پیش‌فرض: خاموش.")
partialAtR   = input.float(2.0, "Partial at R", minval = 0.5, step = 0.5, group = G_RISK)
partialPct   = input.int(50, "Partial size %", minval = 1, maxval = 99, group = G_RISK)

showEma = input.bool(true, "Plot EMA", group = G_FILT, inline = "ema",
     tooltip = "در همه‌ی اسکرین‌شات‌های بک‌تست یک EMA روی چارت هست، پس به عنوان مرجع بصری رسم می‌شود حتی وقتی فیلتر خاموش است.")
emaLen  = input.int(200, "", minval = 1, group = G_FILT, inline = "ema")
useEma  = input.bool(false, "Use EMA as a trend filter", group = G_FILT,
     tooltip = "در فایل صوتی مطرح شد ولی فعلاً کنار گذاشته شد: «میتونی خاموشش کنی بعدا».")
useSess = input.bool(false, "Session filter", group = G_FILT, inline = "sess")
sessStr = input.session("0000-2359", "", group = G_FILT, inline = "sess")

showZones  = input.bool(true, "Draw gap boxes", group = G_VIS)
showDead   = input.bool(true, "Keep cancelled gaps on chart", group = G_VIS,
     tooltip = "روشن باشد تا نقشه‌ی ناحیه‌ها شبیه اسکرین‌شات‌های بک‌تست بماند: ناحیه‌ی باطل‌شده خاکستری می‌شود به جای اینکه پاک شود.")
showBoxes  = input.bool(true, "Draw trade boxes", group = G_VIS)
showLbls   = input.bool(true, "Label trades", group = G_VIS)
showSkips  = input.bool(true, "Mark filtered-out setups", group = G_VIS,
     tooltip = "ستاپی که شرایطش کامل شد ولی فیلتر (پوزیشن باز/سشن/EMA/جهت) اجازه‌ی ورود نداد.")
colBull    = input.color(color.new(#26a69a, 82), "Bullish gap", group = G_VIS)
colBear    = input.color(color.new(#ef5350, 82), "Bearish gap", group = G_VIS)
colArmed   = input.color(color.new(#ffb300, 70), "Armed gap",   group = G_VIS)
colRisk    = input.color(color.new(#ef5350, 80), "Risk box",    group = G_VIS)
colReward  = input.color(color.new(#26a69a, 82), "Reward box",  group = G_VIS)

showDash    = input.bool(true, "Show dashboard", group = G_DASH)
lookbackDay = input.int(5, "Lookback (days)", minval = 1, maxval = 60, group = G_DASH,
     tooltip = "پنجره‌ی آماری داشبورد. بک‌تست دستی فایل صوتی روی ۵ روز بود.")
listRows    = input.int(12, "Trades listed", minval = 0, maxval = 40, group = G_DASH)
dashPos     = input.string("Top right", "Summary position",
     options = ["Top right", "Top left", "Middle right", "Bottom left"], group = G_DASH)
listPos     = input.string("Bottom right", "Trade list position",
     options = ["Bottom right", "Bottom left", "Top left", "Middle left"], group = G_DASH)
dashSize    = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_DASH)

// ------------------------------------------------------------------ types ---
// One tracked fair value gap and the state machine around it.
//   state 0 = formed, waiting for price to come back into it
//   state 1 = price entered, reference candle set, waiting for the engulf
type Fvg
    float top
    float bot
    bool  bull
    int   state
    int   enteredBar
    int   closesIn
    int   updates
    float refHi
    float refLo
    float swHi
    float swLo
    box   bx

// One signal and what became of it.
//   state 0 = running, 1 = target hit, 2 = stopped out, 3 = filtered out
type Trade
    int   id
    bool  isLong
    int   entryBar
    int   entryTime
    float entry
    float stop
    float target
    int   state
    int   exitBar
    box   riskBx
    box   rewardBx
    label lbl

// Label text and colour for a trade in each of its four states. Declared here
// so the signal handler and the resolver render a trade identically.
tradeText(t) =>
    switch t.state
        1 => "#" + str.tostring(t.id) + "  ✓ TP  +" + str.tostring(rr, "#.#") + "R"
        2 => "#" + str.tostring(t.id) + "  ✗ SL  −1R"
        3 => "#" + str.tostring(t.id) + "  ⊘ filtered"
        => "#" + str.tostring(t.id) + "  ● open"

tradeColor(t) =>
    switch t.state
        1 => color.new(#26a69a, 10)
        2 => color.new(#ef5350, 10)
        3 => color.new(color.gray, 35)
        => color.new(color.gray, 20)

// ------------------------------------------------- higher timeframe gaps ----
// Everything is read one HTF bar back so the values come from a *closed* bar.
// That costs at most one entry-timeframe bar of latency and removes any repaint.
// The pattern sits on HTF bars [3], [2] and [1]; time[3] is where it opens.
// A gap is a feature of those three bars, so its box has to be drawn back over
// them rather than at the chart bar that happens to notice it.
htfGaps() =>
    bullOk = low[1] > high[3]
    bearOk = high[1] < low[3]
    [bullOk, high[3], low[1], bearOk, high[1], low[3], time[1], time[3]]

[bullNew, bullBot, bullTop, bearNew, bearBot, bearTop, htfTime, gapStart] =
     request.security(syminfo.tickerid, htfTf, htfGaps(), lookahead = barmerge.lookahead_off)

htfClosed = not na(htfTime) and not na(htfTime[1]) and htfTime != htfTime[1]

// Zone boxes are placed by timestamp, not bar index: the anchor is up to a full
// HTF pattern behind the current bar, and bar_index coordinates may not reach
// far from it. One chart bar of width, in milliseconds.
barMs = timeframe.in_seconds() * 1000

// ---------------------------------------------------------------- filters ---
ema     = ta.ema(close, emaLen)
inSess  = not useSess or not na(time(timeframe.period, sessStr))
flatOk  = not oneAtATime or strategy.position_size == 0
longOk  = allowLong  and inSess and flatOk and (not useEma or close > ema)
shortOk = allowShort and inSess and flatOk and (not useEma or close < ema)

// ------------------------------------------------------------------ state ---
var zones  = array.new<Fvg>()
var trades = array.new<Trade>()
var int tradeSeq = 0

bool  sigLong  = false
bool  sigShort = false
bool  sigSkip  = false
float sigEntry = na
float sigStop  = na
float sigTp    = na

if barstate.isconfirmed

    // --- register gaps confirmed by the last closed HTF bar ------------------
    if htfClosed
        if bullNew and bullTop > bullBot
            z = Fvg.new(top = bullTop, bot = bullBot, bull = true, state = 0,
                 enteredBar = 0, closesIn = 0, updates = 0,
                 refHi = na, refLo = na, swHi = na, swLo = na, bx = na)
            if showZones
                z.bx := box.new(gapStart, z.top, time + barMs, z.bot,
                     xloc = xloc.bar_time,
                     border_color = color.new(color.teal, 40), bgcolor = colBull)
            array.push(zones, z)

        if bearNew and bearTop > bearBot
            z = Fvg.new(top = bearTop, bot = bearBot, bull = false, state = 0,
                 enteredBar = 0, closesIn = 0, updates = 0,
                 refHi = na, refLo = na, swHi = na, swLo = na, bx = na)
            if showZones
                z.bx := box.new(gapStart, z.top, time + barMs, z.bot,
                     xloc = xloc.bar_time,
                     border_color = color.new(color.red, 40), bgcolor = colBear)
            array.push(zones, z)

        // Drop the oldest gaps once we are tracking more than we care about.
        while array.size(zones) > maxZones
            old = array.shift(zones)
            if not na(old.bx)
                box.delete(old.bx)

    // --- advance the state machine ------------------------------------------
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            z = array.get(zones, i)

            bool dead = false
            bool fire = false

            brokeThrough = z.bull ? close < z.bot : close > z.top
            insideClose  = close <= z.top and close >= z.bot

            if z.state == 0
                // Waiting for price to come back. A wick reaching the near edge
                // is contact enough to arm the zone — it does not have to trade
                // through it, and it certainly does not have to close inside.
                entered = z.bull ? low <= z.top : high >= z.bot
                if entered
                    z.state      := 1
                    z.enteredBar := bar_index
                    z.refHi      := high
                    z.refLo      := low
                    z.swHi       := high
                    z.swLo       := low
                    z.closesIn   := insideClose ? 1 : 0
                    if killOnBreak and brokeThrough
                        dead := true
            else
                z.swHi := math.max(z.swHi, high)
                z.swLo := math.min(z.swLo, low)

                if killOnBreak and brokeThrough
                    dead := true

                if not dead
                    // Engulf = a close beyond the reference candle's wick.
                    engulfed = z.bull ? close > z.refHi : close < z.refLo
                    if engulfed
                        fire := true
                    else
                        // A close deeper into the gap moves the reference
                        // candle forward — but only once. A wick alone does
                        // not update it.
                        deeper = z.bull ? close < z.refLo : close > z.refHi
                        if deeper and z.updates < maxUpdates
                            z.updates += 1
                            z.refHi   := high
                            z.refLo   := low

                        if insideClose
                            z.closesIn += 1
                            if z.closesIn > maxClosesInside
                                dead := true

                        if bar_index - z.enteredBar >= maxBarsToEngulf
                            dead := true

            // --- act on the outcome ---------------------------------------
            if fire
                entryPx = close
                stopRaw = switch stopMode
                    "Reference candle"  => z.bull ? z.refLo : z.refHi
                    "Far edge of gap"   => z.bull ? z.bot   : z.top
                    => z.bull ? z.swLo : z.swHi
                buf     = stopBufTicks * syminfo.mintick
                stopPx  = z.bull ? stopRaw - buf : stopRaw + buf
                risk    = math.abs(entryPx - stopPx)
                dirOk   = z.bull ? longOk : shortOk

                if risk > syminfo.mintick
                    sigEntry := entryPx
                    sigStop  := stopPx
                    sigTp    := z.bull ? entryPx + rr * risk : entryPx - rr * risk
                    if not dirOk
                        sigSkip := true
                    else if z.bull
                        sigLong := true
                    else
                        sigShort := true

                dead := true

            if dead
                if not na(z.bx)
                    if showDead
                        box.set_bgcolor(z.bx, color.new(color.gray, 90))
                        box.set_border_color(z.bx, color.new(color.gray, 60))
                    else
                        box.delete(z.bx)
                array.remove(zones, i)
            else if not na(z.bx)
                box.set_right(z.bx, time + barMs)
                if z.state == 1
                    box.set_bgcolor(z.bx, colArmed)

    // --- open a trade record for this bar's signal ---------------------------
    if sigLong or sigShort or (sigSkip and showSkips)
        tradeSeq += 1
        isL = sigLong or (sigSkip and sigTp > sigEntry)
        t = Trade.new(id = tradeSeq, isLong = isL, entryBar = bar_index,
             entryTime = time, entry = sigEntry, stop = sigStop, target = sigTp,
             state = sigSkip ? 3 : 0, exitBar = bar_index,
             riskBx = na, rewardBx = na, lbl = na)

        if showBoxes and not sigSkip
            t.riskBx := box.new(bar_index, math.max(t.entry, t.stop), bar_index + 1,
                 math.min(t.entry, t.stop), border_color = color.new(#ef5350, 55),
                 bgcolor = colRisk)
            t.rewardBx := box.new(bar_index, math.max(t.entry, t.target), bar_index + 1,
                 math.min(t.entry, t.target), border_color = color.new(#26a69a, 55),
                 bgcolor = colReward)

        if showLbls
            t.lbl := label.new(bar_index, t.entry, tradeText(t),
                 style = isL ? label.style_label_up : label.style_label_down,
                 color = tradeColor(t), textcolor = color.white, size = size.tiny)

        array.push(trades, t)

        // Two boxes and a label per trade against TradingView's 500-drawing
        // budget. Cap the tracked set so drawings are not culled behind our
        // back, which would leave the dashboard describing trades that are no
        // longer on the chart.
        while array.size(trades) > 150
            gone = array.shift(trades)
            if not na(gone.riskBx)
                box.delete(gone.riskBx)
            if not na(gone.rewardBx)
                box.delete(gone.rewardBx)
            if not na(gone.lbl)
                label.delete(gone.lbl)

    // --- resolve open trades and maintain their drawings --------------------
    if array.size(trades) > 0
        for i = array.size(trades) - 1 to 0
            t = array.get(trades, i)

            // Retire everything older than the dashboard window so the 500
            // drawing budget stays inside the range we actually report on.
            if t.entryTime < last_bar_time - lookbackDay * 86400000
                if not na(t.riskBx)
                    box.delete(t.riskBx)
                if not na(t.rewardBx)
                    box.delete(t.rewardBx)
                if not na(t.lbl)
                    label.delete(t.lbl)
                array.remove(trades, i)

            else if t.state == 0
                // Only a running trade has its drawings touched. Re-setting a
                // finished trade's right edge on every later bar eventually
                // throws at runtime: a bar_index coordinate has to stay near
                // the current bar, and a resolved trade's edge does not move.
                bool resolved = false

                if bar_index > t.entryBar
                    hitStop = t.isLong ? low  <= t.stop   : high >= t.stop
                    hitTp   = t.isLong ? high >= t.target : low  <= t.target
                    // A bar spanning both levels is scored as a loss: the order
                    // of touches inside a bar is unknowable from bar data.
                    if hitStop
                        t.state   := 2
                        t.exitBar := bar_index
                        resolved  := true
                    else if hitTp
                        t.state   := 1
                        t.exitBar := bar_index
                        resolved  := true

                edge = resolved ? t.exitBar : bar_index + 1
                if not na(t.riskBx)
                    box.set_right(t.riskBx, edge)
                if not na(t.rewardBx)
                    box.set_right(t.rewardBx, edge)
                if resolved and not na(t.lbl)
                    label.set_text(t.lbl, tradeText(t))
                    label.set_color(t.lbl, tradeColor(t))

// ------------------------------------------------------------------ orders --
var float tEntry   = na
var float tStop    = na
var float tTp      = na
var float tPartial = na
var bool  tIsLong  = false
var bool  tPartHit = false

if sigLong or sigShort
    tEntry   := sigEntry
    tStop    := sigStop
    tTp      := sigTp
    tIsLong  := sigLong
    tPartHit := false
    risk     = math.abs(sigEntry - sigStop)
    tPartial := sigLong ? sigEntry + partialAtR * risk : sigEntry - partialAtR * risk

    // Risk-based sizing: lose exactly riskPct of equity if the stop is hit.
    qty = useRiskSize ? (strategy.equity * riskPct / 100) / risk : na
    strategy.entry(sigLong ? "Long" : "Short", sigLong ? strategy.long : strategy.short,
         qty = useRiskSize ? qty : na)

if strategy.position_size != 0 and not na(tStop)
    fromId = tIsLong ? "Long" : "Short"

    if usePartial and not tPartHit
        strategy.exit("Partial", from_entry = fromId, limit = tPartial, qty_percent = partialPct)
        if tIsLong ? high >= tPartial : low <= tPartial
            tPartHit := true

    // Once the partial is banked the remainder rides with a break-even stop.
    stopNow = usePartial and tPartHit ? tEntry : tStop
    strategy.exit("Exit", from_entry = fromId, stop = stopNow, limit = tTp)

// ------------------------------------------------------------------ plots ---
plotshape(sigLong,  title = "Long",  style = shape.triangleup,
     location = location.belowbar, color = color.new(color.teal, 0), size = size.small)
plotshape(sigShort, title = "Short", style = shape.triangledown,
     location = location.abovebar, color = color.new(color.red, 0),  size = size.small)

plot(showEma ? ema : na, "EMA", color = color.new(#2196f3, 20))

// Guard rail: this only works when the chart is on the entry timeframe.
var label tfWarn = na
if barstate.islast
    label.delete(tfWarn)
    if timeframe.in_seconds() > timeframe.in_seconds(htfTf)
        tfWarn := label.new(bar_index, high,
             "⚠ Chart timeframe is above the FVG timeframe (" + htfTf + ").\nSwitch the chart to the entry timeframe (1m).",
             style = label.style_label_down, color = color.new(color.orange, 10),
             textcolor = color.black, size = size.small)

// -------------------------------------------------------------- dashboard ---
posOf(s) =>
    switch s
        "Top left"      => position.top_left
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        => position.bottom_right

txtSize = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small

C_HEAD = color.new(#37474f, 15)
C_ROW  = color.new(#263238, 55)
C_WIN  = color.new(#26a69a, 20)
C_LOSS = color.new(#ef5350, 20)
C_TXT  = color.white

// Pine only allows function declarations at global scope, so these take the
// table and the row's colours as arguments instead of closing over them.
sumRow(t, r, k, v, bg, sz) =>
    table.cell(t, 0, r, k, bgcolor = C_ROW, text_color = C_TXT, text_size = sz,
         text_halign = text.align_left)
    table.cell(t, 1, r, v, bgcolor = bg, text_color = C_TXT, text_size = sz,
         text_halign = text.align_right)

listCell(t, c, r, s, bg, sz) =>
    table.cell(t, c, r, s, bgcolor = bg, text_color = C_TXT, text_size = sz)

var table sumT  = na
var table listT = na

if showDash and barstate.islast
    // --- roll the trade array up into statistics ----------------------------
    int nTp    = 0
    int nSl    = 0
    int nOpen  = 0
    int nSkip  = 0
    int maxWin = 0
    int maxLos = 0
    int runWin = 0
    int runLos = 0
    int curRun = 0

    if array.size(trades) > 0
        for i = 0 to array.size(trades) - 1
            t = array.get(trades, i)
            if t.state == 1
                nTp    += 1
                runWin += 1
                runLos := 0
                curRun := runWin
                maxWin := math.max(maxWin, runWin)
            else if t.state == 2
                nSl    += 1
                runLos += 1
                runWin := 0
                curRun := -runLos
                maxLos := math.max(maxLos, runLos)
            else if t.state == 3
                nSkip += 1
            else
                nOpen += 1

    closed = nTp + nSl
    // Pine does integer division when both operands are int, so force float.
    winRt  = closed > 0 ? 100.0 * nTp / closed : 0.0
    netR   = nTp * rr - nSl
    perDay = closed / math.max(lookbackDay, 1.0)

    table.delete(sumT)
    sumT := table.new(posOf(dashPos), 2, 11, border_width = 1,
         frame_color = C_HEAD, frame_width = 1)

    table.cell(sumT, 0, 0, "M+ FVG", bgcolor = C_HEAD, text_color = C_TXT, text_size = txtSize)
    table.cell(sumT, 1, 0, "last " + str.tostring(lookbackDay) + "d",
         bgcolor = C_HEAD, text_color = C_TXT, text_size = txtSize)

    sumRow(sumT, 1,  "Trades",       str.tostring(closed), C_ROW,  txtSize)
    sumRow(sumT, 2,  "Target",       str.tostring(nTp),    C_WIN,  txtSize)
    sumRow(sumT, 3,  "Stop",         str.tostring(nSl),    C_LOSS, txtSize)
    sumRow(sumT, 4,  "Open",         str.tostring(nOpen),  C_ROW,  txtSize)
    sumRow(sumT, 5,  "Win rate",     str.tostring(winRt, "#.#") + "%",
         winRt >= 50 ? C_WIN : C_ROW, txtSize)
    sumRow(sumT, 6,  "Best TP run",  str.tostring(maxWin), C_WIN,  txtSize)
    sumRow(sumT, 7,  "Worst SL run", str.tostring(maxLos), C_LOSS, txtSize)
    sumRow(sumT, 8,  "Current run",  (curRun > 0 ? "+" : "") + str.tostring(curRun),
         curRun > 0 ? C_WIN : curRun < 0 ? C_LOSS : C_ROW, txtSize)
    sumRow(sumT, 9,  "Net R",        (netR >= 0 ? "+" : "") + str.tostring(netR, "#.#") + "R",
         netR >= 0 ? C_WIN : C_LOSS, txtSize)
    sumRow(sumT, 10, "Trades / day", str.tostring(perDay, "#.#") +
         (nSkip > 0 ? "   (" + str.tostring(nSkip) + " filtered)" : ""), C_ROW, txtSize)

    // --- the trade list -----------------------------------------------------
    table.delete(listT)
    if listRows > 0 and array.size(trades) > 0
        shown = math.min(listRows, array.size(trades))
        listT := table.new(posOf(listPos), 7, shown + 1, border_width = 1,
             frame_color = C_HEAD, frame_width = 1)

        listCell(listT, 0, 0, "#",      C_HEAD, txtSize)
        listCell(listT, 1, 0, "Time",   C_HEAD, txtSize)
        listCell(listT, 2, 0, "Dir",    C_HEAD, txtSize)
        listCell(listT, 3, 0, "Entry",  C_HEAD, txtSize)
        listCell(listT, 4, 0, "Stop",   C_HEAD, txtSize)
        listCell(listT, 5, 0, "Target", C_HEAD, txtSize)
        listCell(listT, 6, 0, "R",      C_HEAD, txtSize)

        // newest first
        for r = 1 to shown
            t = array.get(trades, array.size(trades) - r)
            bg = switch t.state
                1 => C_WIN
                2 => C_LOSS
                3 => color.new(color.gray, 70)
                => C_ROW
            rTxt = switch t.state
                1 => "+" + str.tostring(rr, "#.#")
                2 => "−1.0"
                3 => "filtered"
                => "open"
            listCell(listT, 0, r, str.tostring(t.id), bg, txtSize)
            listCell(listT, 1, r, str.format_time(t.entryTime, "MM-dd HH:mm", syminfo.timezone), bg, txtSize)
            listCell(listT, 2, r, t.isLong ? "LONG" : "SHORT", bg, txtSize)
            listCell(listT, 3, r, str.tostring(t.entry,  format.mintick), bg, txtSize)
            listCell(listT, 4, r, str.tostring(t.stop,   format.mintick), bg, txtSize)
            listCell(listT, 5, r, str.tostring(t.target, format.mintick), bg, txtSize)
            listCell(listT, 6, r, rTxt, bg, txtSize)
